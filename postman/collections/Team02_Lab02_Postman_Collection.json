      "name": "01_Storefront_Catalog",
      "item": [
        {
          "name": "Get Product List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Product Variants",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// pm.test(\"Response should contain a variants array\", function () {",
                  "//     pm.expect(jsonData).to.have.property(\"variants\");",
                  "//     pm.expect(jsonData.variants).to.be.an(\"array\");",
                  "// });",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"variantId\", jsonData.variants[0].id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product-variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product-variants"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"cartId\", jsonData.cart.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Item to cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Tier 1: Verify HTTP Status Code (Return 200 OK or 201 Created)",
                  "pm.test(\"Tier 1: Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "// Tier 2: Verify SLA Performance (< 2000ms)",
                  "pm.test(\"Tier 2: Response time is below 2000ms SLA\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "// Tier 3: Verify Content-Type Header",
                  "pm.test(\"Tier 3: Content-Type is application/json\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "});",
                  "",
                  "// Tier 4: Verify Logic - Item Line is not empty",
                  "pm.test(\"Tier 4: Line item array is updated and non-empty\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.cart.items).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"variant_id\": \"{{variantId}}\",\n    \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/line-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "line-items"
              ]
            }
          },
          "response": []
        }
      ],
