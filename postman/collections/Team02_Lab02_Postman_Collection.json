                  "})",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('apiToken', jsonData.token || pm.response.headers.get('Set-Cookie'));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
